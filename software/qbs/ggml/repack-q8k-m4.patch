 #include <cmath>
@@ -386,7 +387,21 @@ template <> void ggml_quantize_mat_t<1, GGML_TYPE_Q8_0>(const float * GGML_RESTR
 template <> void ggml_quantize_mat_t<1, GGML_TYPE_Q8_K>(const float * GGML_RESTRICT x, void * GGML_RESTRICT vy, int64_t nrow, int64_t n_per_row) {
     assert(nrow == 4);
     UNUSED(nrow);
+#if defined(GGML_USE_RISCV_QBS) && !defined(__riscv_zvfh)
+    const bool enabled = qbs_m4_prepare_enabled();
+    bool vector_used = false;
+    if (enabled) {
+        vector_used = ggml_riscv_q8_K_m4::quantize(x, vy, n_per_row);
