       mstatus_d.spp  = 1'b0;
       // set spie to 1
       mstatus_d.spie = 1'b1;
+      mstatus_d.mprv = 1'b0;
       if (CVA6Cfg.RVH) begin
         // set virtualization mode
         v_d            = hstatus_q.spv;
