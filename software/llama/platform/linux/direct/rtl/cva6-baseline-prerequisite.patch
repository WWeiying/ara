         hstatus_d.spv  = 1'b0;
-        mstatus_d.mprv = 1'b0;
       end
       // restore sintstatus
       if (CVA6Cfg.RVSCLIC && clic_mode_o && scause_q[CVA6Cfg.XLEN-1])
