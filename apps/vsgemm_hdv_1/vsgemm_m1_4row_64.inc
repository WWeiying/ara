__attribute__((naked, aligned(16), section(".hdv_task"),
               target("arch=rv64gcv_zfh_zvfh")))
void gemm_f32_64x64x64_4row(const float *A, const float *B, float *C) {
    // ABI: a0=A, a1=B, a2=C. m1, fixed 64, 4-row blocking.
    __asm__ volatile (
    ".option push\n"
    ".option norvc\n"
    ".option norelax\n"
    ".macro HDV_HINT pbits=0x1f, packet256=0, cross=0, loop_start=0, loop_end=0, prefetch_mode=0, prefetch_disable=0\n"
    "  lui x0, (((\\pbits) & 0x1fff) | (((\\packet256) & 1) << 13) | (((\\cross) & 1) << 14) | (((\\loop_start) & 1) << 15) | (((\\loop_end) & 1) << 16) | (((\\prefetch_mode) & 3) << 17) | (((\\prefetch_disable) & 1) << 19))\n"
    ".endm\n"
    ".balign 16\n"
    "vsgemm_hdv_task_start:\n"
    "HDV_HINT 0x00\n"
    "addi a3, zero, 1\n"
    "slli a3, a3, 11\n"
    "vsetvli zero, a3, e32, m1, ta, ma\n"
    "HDV_HINT 0x0a\n"
    "addi t0, zero, 16\n"
    "mv t1, a0\n"
    "mv t2, a2\n"
    "nop\n"

    ".balign 16\n"
    "row_block_loop_64:\n"
    "HDV_HINT 0x0a, 0, 0, 1, 0\n"
    "vmv.v.i v8, 0\n"
    "vmv.v.i v9, 0\n"
    "vmv.v.i v10, 0\n"
    "HDV_HINT 0x0a\n"
    "vmv.v.i v11, 0\n"
    "vmv.v.i v12, 0\n"
    "vmv.v.i v13, 0\n"
    "HDV_HINT 0x02\n"
    "vmv.v.i v14, 0\n"
    "vmv.v.i v15, 0\n"
    "nop\n"

    "HDV_HINT 0x0a\n"
    "mv t3, t1\n"
    "mv a3, a1\n"
    "addi a4, zero, 1\n"
    "HDV_HINT 0x00\n"
    "slli a4, a4, 11\n"
    "nop\n"
    "nop\n"

    ".balign 16\n"
    "k_loop_64:\n"
    "HDV_HINT 0x2a, 1, 0, 1, 0, 1\n"
    "flw fa0, 0(t3)\n"
    "flw fa1, 256(t3)\n"
    "flw fa2, 512(t3)\n"
    "flw fa3, 768(t3)\n"
    "vle32.v v0, (a3)\n"
    "addi a5, a3, 128\n"
    "vle32.v v1, (a5)\n"

    "HDV_HINT 0x2a, 1, 1, 0, 0\n"
    "vfmacc.vf v8, fa0, v0\n"
    "vfmacc.vf v9, fa0, v1\n"
    "vfmacc.vf v10, fa1, v0\n"
    "vfmacc.vf v11, fa1, v1\n"
    "vfmacc.vf v12, fa2, v0\n"
    "vfmacc.vf v13, fa2, v1\n"
    "vfmacc.vf v14, fa3, v0\n"

    "HDV_HINT 0x28, 1, 0, 0, 1\n"
    "vfmacc.vf v15, fa3, v1\n"
    "addi t3, t3, 4\n"
    "addi a3, a3, 256\n"
    "addi a4, a4, -32\n"
    "bnez a4, k_loop_64\n"
    "nop\n"
    "nop\n"

    // Eight result stores plus address/count updates use 19 instructions:
    // one 256-bit packet and four 128-bit packets, with no repeated padding.
    "HDV_HINT 0x00, 1, 0\n"
    "vse32.v v8, (t2)\n"
    "addi a5, t2, 128\n"
    "vse32.v v9, (a5)\n"
    "addi a3, t2, 256\n"
    "vse32.v v10, (a3)\n"
    "addi a5, a3, 128\n"
    "vse32.v v11, (a5)\n"

    "HDV_HINT 0x00\n"
    "addi a3, t2, 512\n"
    "vse32.v v12, (a3)\n"
    "addi a5, a3, 128\n"

    "HDV_HINT 0x00\n"
    "vse32.v v13, (a5)\n"
    "addi a3, t2, 768\n"
    "vse32.v v14, (a3)\n"

    "HDV_HINT 0x00, 0, 1\n"
    "addi a5, a3, 128\n"
    "vse32.v v15, (a5)\n"
    "addi t1, t1, 1024\n"

    "HDV_HINT 0x02, 0, 0, 0, 1\n"
    "addi t2, t2, 1024\n"
    "addi t0, t0, -1\n"
    "bnez t0, row_block_loop_64\n"
    "HDV_HINT\n"
    "ret\n"
    "nop\n"
    "nop\n"
    ".purgem HDV_HINT\n"
    ".option pop\n"
    );
}
