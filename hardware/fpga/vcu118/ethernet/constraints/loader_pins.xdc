# Standalone loader_bd_wrapper ports. DDR data pins use the generated DDR4 IP XDC.
set_property -dict {PACKAGE_PIN E12 IOSTANDARD LVDS} [get_ports {sys_clk_250_clk_p[0]}]
set_property -dict {PACKAGE_PIN D12 IOSTANDARD LVDS} [get_ports {sys_clk_250_clk_n[0]}]
set_property -dict {PACKAGE_PIN AT22 IOSTANDARD LVDS} [get_ports sgmii_phyclk_clk_p]
set_property -dict {PACKAGE_PIN AU22 IOSTANDARD LVDS} [get_ports sgmii_phyclk_clk_n]
set_property -dict {PACKAGE_PIN AU21 IOSTANDARD DIFF_HSTL_I_DCI_18} [get_ports sgmii_lvds_txp]
set_property -dict {PACKAGE_PIN AV21 IOSTANDARD DIFF_HSTL_I_DCI_18} [get_ports sgmii_lvds_txn]
set_property -dict {PACKAGE_PIN AU24 IOSTANDARD DIFF_HSTL_I_DCI_18} [get_ports sgmii_lvds_rxp]
set_property -dict {PACKAGE_PIN AV24 IOSTANDARD DIFF_HSTL_I_DCI_18} [get_ports sgmii_lvds_rxn]
set_property -dict {PACKAGE_PIN AR23 IOSTANDARD LVCMOS18} [get_ports mdio_mdc_mdio_io]
set_property -dict {PACKAGE_PIN AV23 IOSTANDARD LVCMOS18} [get_ports mdio_mdc_mdc]
set_property -dict {PACKAGE_PIN BA21 IOSTANDARD LVCMOS18} [get_ports {phy_reset_out[0]}]
set_property -dict {PACKAGE_PIN L19 IOSTANDARD LVCMOS12} [get_ports sys_reset]
set_property OUTPUT_IMPEDANCE RDRV_48_48 [get_ports {sgmii_lvds_txp sgmii_lvds_txn}]
set_property ODT RTT_48 [get_ports {sgmii_lvds_rxp sgmii_lvds_rxn}]
set_property DIFF_TERM_ADV TERM_100 [get_ports {sgmii_phyclk_clk_p sgmii_phyclk_clk_n}]
create_clock -name loader_clk_250 -period 4.000 [get_ports {sys_clk_250_clk_p[0]}]
