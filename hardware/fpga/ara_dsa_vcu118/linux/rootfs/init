#!/bin/busybox sh

export PATH=/sbin:/bin:/usr/sbin:/usr/bin
export HOME=/root
export TERM=vt100

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mkdir -p /dev/pts /dev/shm /run /tmp
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t tmpfs tmpfs /run 2>/dev/null || true
mount -t tmpfs tmpfs /tmp 2>/dev/null || true

echo "Ara DSA VCU118 Linux init reached"
echo "Linux console, DDR and RVV handoff are alive"
echo "Interactive initramfs: type commands on the UART console"

exec /bin/busybox setsid -c /bin/busybox sh </dev/console >/dev/console 2>&1
