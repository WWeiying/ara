// Explicit flattened ports of write_verilog -cell i_vldu, not a resynthesized probe.
// This boundary output was optimized outside i_vldu. Observe actual internal
// state using the RTL queue-full equation; the external ready cone is NOT tested.
assign req_ready = {dut.\vinsn_queue_q_reg[commit_cnt_n_0_][2] ,
                    dut.\vinsn_queue_q_reg[commit_cnt_n_0_][1] ,
                    dut.\vinsn_queue_q_reg[commit_cnt_n_0_][0] } != 3'd4;
vldu dut (
  .clk_i, .rst_ni,
  .\axi_r_i[id] (2'b0), .\axi_r_i[data] (r.data),
  .\axi_r_i[resp] (2'b0), .\axi_r_i[last] ((beat+1)*16==bytes_for(memory_insn)),
  .\axi_r_i[user] (2'b0),
  .axi_r_valid_i(rvalid), .axi_r_ready_o(rready),
  .\pe_req_i[id] (request.id), .\pe_req_i[op] (request.op),
  .\pe_req_i[vm] (request.vm), .\pe_req_i[eew_vmask] (request.eew_vmask),
  .\pe_req_i[vfu] (request.vfu), .\pe_req_i[scale_vl] (request.scale_vl),
  .\pe_req_i[start_lane] (request.start_lane), .\pe_req_i[end_lane] (request.end_lane),
  .\pe_req_i[vs1] (request.vs1), .\pe_req_i[use_vs1] (request.use_vs1),
  .\pe_req_i[conversion_vs1] (request.conversion_vs1),
  .\pe_req_i[eew_vs1] (request.eew_vs1), .\pe_req_i[old_eew_vs1] (request.old_eew_vs1),
  .\pe_req_i[vs2] (request.vs2), .\pe_req_i[use_vs2] (request.use_vs2),
  .\pe_req_i[conversion_vs2] (request.conversion_vs2),
  .\pe_req_i[eew_vs2] (request.eew_vs2), .\pe_req_i[old_eew_vs2] (request.old_eew_vs2),
  .\pe_req_i[use_vd_op] (request.use_vd_op), .\pe_req_i[eew_vd_op] (request.eew_vd_op),
  .\pe_req_i[scalar_op] (request.scalar_op), .\pe_req_i[use_scalar_op] (request.use_scalar_op),
  .\pe_req_i[swap_vs2_vd_op] (request.swap_vs2_vd_op),
  .\pe_req_i[stride] (request.stride), .\pe_req_i[is_stride_np2] (request.is_stride_np2),
  .\pe_req_i[vd] (request.vd), .\pe_req_i[use_vd] (request.use_vd),
  .\pe_req_i[emul] (request.emul), .\pe_req_i[fp_rm] (request.fp_rm),
  .\pe_req_i[wide_fp_imm] (request.wide_fp_imm), .\pe_req_i[cvt_resize] (request.cvt_resize),
  .\pe_req_i[overlap_capture] (request.overlap_capture),
  .\pe_req_i[overlap_use_snapshot] (request.overlap_use_snapshot),
  .\pe_req_i[overlap_snapshot_word] (request.overlap_snapshot_word),
  .\pe_req_i[source_snapshot_capture] (request.source_snapshot_capture),
  .\pe_req_i[source_snapshot_replay_vs1] (request.source_snapshot_replay_vs1),
  .\pe_req_i[source_snapshot_replay_vs2] (request.source_snapshot_replay_vs2),
  .\pe_req_i[vl] (request.vl), .\pe_req_i[vstart] (request.vstart),
  .\pe_req_i[vtype][vill] (request.vtype.vill),
  .\pe_req_i[vtype][vma] (request.vtype.vma), .\pe_req_i[vtype][vta] (request.vtype.vta),
  .\pe_req_i[vtype][vsew] (request.vtype.vsew), .\pe_req_i[vtype][vlmul] (request.vtype.vlmul),
  .\pe_req_i[fault_only_first] (request.fault_only_first),
  .\pe_req_i[akv_refill] (request.akv_refill), .\pe_req_i[akv_v2] (request.akv_v2),
  .\pe_req_i[akv_column] (request.akv_column),
  .\pe_req_i[hazard_vs1] (request.hazard_vs1), .\pe_req_i[hazard_vs2] (request.hazard_vs2),
  .\pe_req_i[hazard_vm] (request.hazard_vm), .\pe_req_i[hazard_vd] (request.hazard_vd),
  .\pe_req_i[hazard_source_lifetime] (request.hazard_source_lifetime),
  .\pe_req_i[hazard_wait_complete] (request.hazard_wait_complete),
  .pe_req_valid_i(req_valid), .pe_req_ready_o(), .pe_vinsn_running_i(running),
  .\pe_resp_o[vinsn_done] (response.vinsn_done),
  .\axi_addrgen_req_i[addr] (address.addr), .\axi_addrgen_req_i[vaddr] (address.vaddr),
  .\axi_addrgen_req_i[elem_start] (address.elem_start),
  .\axi_addrgen_req_i[size] (address.size), .\axi_addrgen_req_i[len] (address.len),
  .\axi_addrgen_req_i[is_load] (address.is_load),
  .\axi_addrgen_req_i[is_exception] (address.is_exception),
  .\axi_addrgen_req_i[is_skip] (address.is_skip),
  .axi_addrgen_req_valid_i(addrvalid), .axi_addrgen_req_ready_o(addrready),
  .addrgen_illegal_load_i(1'b0), .lsu_ex_flush_i(1'b0),
  .ldu_result_req_o(valid), .ldu_result_gnt_i(grant), .ldu_result_final_gnt_i(final_grant),
  .\ldu_result_id_o[0] (ids[0]), .\ldu_result_id_o[1] (ids[1]),
  .\ldu_result_id_o[2] (ids[2]), .\ldu_result_id_o[3] (ids[3]),
  .\ldu_result_addr_o[0] (addrs[0]), .\ldu_result_addr_o[1] (addrs[1]),
  .\ldu_result_addr_o[2] (addrs[2]), .\ldu_result_addr_o[3] (addrs[3]),
  .\ldu_result_wdata_o[0] (data[0]), .\ldu_result_wdata_o[1] (data[1]),
  .\ldu_result_wdata_o[2] (data[2]), .\ldu_result_wdata_o[3] (data[3]),
  .\ldu_result_be_o[0] (be[0]), .\ldu_result_be_o[1] (be[1]),
  .\ldu_result_be_o[2] (be[2]), .\ldu_result_be_o[3] (be[3]),
  .\mask_i[0] (8'b0), .\mask_i[1] (8'b0), .\mask_i[2] (8'b0), .\mask_i[3] (8'b0),
  .mask_valid_i(4'b0), .mask_owner_id_i(3'b0), .mask_first_element_i(11'b0)
);
