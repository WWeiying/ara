     assign fpu_vec_op = use_hold ? fpu_vec_op_q : fpu_vec_op_d;
     assign fpu_tag    = use_hold ? fpu_tag_q : fpu_tag_d;
 
+    // Canonicalize malformed scalar operands before div/sqrt.  This keeps
+    // scalar NaN-boxing behavior explicit across the available backends.
+    function automatic logic [CVA6Cfg.FLen-1:0] canonical_nan(
+        input fpnew_pkg::fp_format_e fmt
+    );
+      logic [CVA6Cfg.FLen-1:0] value;
+      value = '1;
+      unique case (fmt)
+        fpnew_pkg::FP64:    value = 64'h7ff8_0000_0000_0000;
+        fpnew_pkg::FP32:    value[31:0] = 32'h7fc0_0000;
+        fpnew_pkg::FP16:    value[15:0] = 16'h7e00;
+        fpnew_pkg::FP16ALT: value[15:0] = 16'h7fc0;
+        fpnew_pkg::FP8:     value[7:0]  = 8'h7e;
+        default:            value = '1;
+      endcase
+      return value;
+    endfunction
+
+    function automatic logic [CVA6Cfg.FLen-1:0] canonicalize_unboxed(
+        input logic [CVA6Cfg.FLen-1:0] value,
+        input fpnew_pkg::fp_format_e fmt
+    );
+      automatic int unsigned fmt_width = fpnew_pkg::fp_width(fmt);
+      automatic logic is_boxed = 1'b1;
+      for (int unsigned bit_idx = fmt_width; bit_idx < CVA6Cfg.FLen; bit_idx++) begin
+        is_boxed &= value[bit_idx];
+      end
+      return is_boxed ? value : canonical_nan(fmt);
+    endfunction
+
     // Consolidate operands
     logic [2:0][CVA6Cfg.FLen-1:0] fpu_operands;
 
-    assign fpu_operands[0] = operand_a;
-    assign fpu_operands[1] = operand_b;
-    assign fpu_operands[2] = operand_c;
+    always_comb begin
+      fpu_operands[0] = operand_a;
+      fpu_operands[1] = operand_b;
+      fpu_operands[2] = operand_c;
+
+      if (!fpu_vec_op && (fpu_op == fpnew_pkg::DIV)) begin
+        fpu_operands[0] = canonicalize_unboxed(operand_a, fpnew_pkg::fp_format_e'(fpu_srcfmt));
+        fpu_operands[1] = canonicalize_unboxed(operand_b, fpnew_pkg::fp_format_e'(fpu_srcfmt));
+      end else if (!fpu_vec_op && (fpu_op == fpnew_pkg::SQRT)) begin
+        fpu_operands[0] = canonicalize_unboxed(operand_a, fpnew_pkg::fp_format_e'(fpu_srcfmt));
