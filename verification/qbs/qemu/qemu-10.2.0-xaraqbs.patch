+++ b/target/riscv/qbs_helper.c
@@ -0,0 +1,177 @@
+/*
+ * QEMU functional model for the Xaraqbs quantized block-stream extension.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "internals.h"
+#include "vector_internals.h"
+#include "accel/tcg/cpu-ldst.h"
+#include "accel/tcg/probe.h"
+#include "exec/helper-proto.h"
+#include "exec/target_page.h"
+#include "qbs_ref.h"
+
+static G_NORETURN void qbs_raise_illegal(CPURISCVState *env, uint32_t insn,
+                                         uintptr_t retaddr)
+{
+    env->bins = insn;
+    riscv_raise_exception(env, RISCV_EXCP_ILLEGAL_INST, retaddr);
+}
+
+static void qbs_guest_read(CPURISCVState *env, target_ulong guest_address,
+                           void *destination, size_t bytes,
+                           uintptr_t retaddr)
+{
+    CPUState *cs = env_cpu(env);
+    int mmu_index = cpu_mmu_index(cs, false);
+    uint8_t *output = destination;
+
+    while (bytes != 0) {
+        target_ulong address = adjust_addr(env, guest_address);
+        size_t page_bytes = -(address | TARGET_PAGE_MASK);
+        size_t chunk = MIN(bytes, page_bytes);
+        void *host = probe_read(env, address, chunk, mmu_index, retaddr);
+
+        if (host != NULL) {
+            memcpy(output, host, chunk);
+        } else {
+            for (size_t index = 0; index < chunk; ++index) {
+                output[index] = cpu_ldub_mmuidx_ra(env, address + index,
+                                                   mmu_index, retaddr);
+            }
+        }
+        guest_address += chunk;
+        output += chunk;
+        bytes -= chunk;
+    }
+}
+
+static unsigned qbs_destination_registers(unsigned m)
+{
+    return m == 1 ? 1 : (m == 2 ? 2 : 4);
+}
+
+static void qbs_copy_destination_from_env(CPURISCVState *env, unsigned vd,
+                                          unsigned registers,
+                                          float *destination)
+{
+    const unsigned elements = riscv_cpu_cfg(env)->vlenb / sizeof(uint32_t);
+    uint32_t *vector_words = (uint32_t *)env->vreg;
+
+    for (unsigned reg = 0; reg < registers; ++reg) {
+        for (unsigned element = 0; element < elements; ++element) {
+            uint32_t bits = vector_words[(vd + reg) * elements + H4(element)];
+            memcpy(&destination[reg * elements + element], &bits,
+                   sizeof(bits));
+        }
+    }
+}
+
+static void qbs_commit_destination(CPURISCVState *env, unsigned vd,
+                                   unsigned registers,
+                                   const float *destination)
+{
+    const unsigned elements = riscv_cpu_cfg(env)->vlenb / sizeof(uint32_t);
+    uint32_t *vector_words = (uint32_t *)env->vreg;
+
+    for (unsigned reg = 0; reg < registers; ++reg) {
+        for (unsigned element = 0; element < elements; ++element) {
+            uint32_t bits;
+            memcpy(&bits, &destination[reg * elements + element],
+                   sizeof(bits));
+            vector_words[(vd + reg) * elements + H4(element)] = bits;
+        }
+    }
+}
+
+target_ulong helper_qbs_info(CPURISCVState *env, target_ulong index)
+{
+#if HOST_BIG_ENDIAN
+    return 0;
+#else
+    return qbs_ref_capability_word(index, riscv_cpu_cfg(env)->vlenb * 8u);
+#endif
+}
+
+void helper_qbs_exec(CPURISCVState *env, target_ulong descriptor_address,
+                     target_ulong activation_address, uint32_t vd,
+                     uint32_t m, uint32_t insn)
+{
+    const uintptr_t retaddr = GETPC();
+    qbs_descriptor_v1_t descriptor QEMU_ALIGNED(16);
+    qbs_descriptor_fields_t fields;
+    qbs_ref_result_t result;
+    qbs_ref_status_t status;
+    size_t weight_bytes;
+    size_t activation_bytes;
+    unsigned registers;
+    unsigned elements;
+    g_autofree uint8_t *weights = NULL;
+    g_autofree uint8_t *activations = NULL;
+    float destination[4 * RV_VLEN_MAX / 32];
+
+#if HOST_BIG_ENDIAN
+    qbs_raise_illegal(env, insn, retaddr);
+#endif
+
+    registers = qbs_destination_registers(m);
+    if (m == 0 || m > QBS_MAX_M || vd >= 32 ||
+        (vd % registers) != 0 || vd + registers > 32 || env->vstart != 0 ||
+        (descriptor_address & (QBS_DESCRIPTOR_BYTES - 1u)) != 0 ||
+        (activation_address &
+         ((UINT64_C(1) << QBS_ACTIVATION_BASE_ALIGNMENT_LOG2) - 1u)) != 0) {
+        qbs_raise_illegal(env, insn, retaddr);
+    }
+
+    descriptor.header = cpu_ldq_le_data_ra(
+        env, adjust_addr(env, descriptor_address), retaddr);
+    descriptor.weight_base = cpu_ldq_le_data_ra(
+        env, adjust_addr(env, descriptor_address + sizeof(uint64_t)), retaddr);
+
+    status = qbs_ref_validate_descriptor(
+        &descriptor, m, vd, riscv_cpu_cfg(env)->vlenb * 8u,
+        activation_address);
+    if (status != QBS_REF_OK) {
+        qbs_raise_illegal(env, insn, retaddr);
+    }
+
+    fields = qbs_unpack_descriptor_header(descriptor.header);
+    weight_bytes = qbs_ref_weight_storage_bytes(
+        fields.weight_profile, fields.weight_layout, fields.n,
+        fields.k_blocks);
+    activation_bytes = qbs_ref_activation_storage_bytes_for_profile(
+        fields.activation_profile, fields.activation_layout, m,
+        fields.k_blocks);
+    if (weight_bytes == 0 || activation_bytes == 0) {
+        qbs_raise_illegal(env, insn, retaddr);
+    }
+
+    weights = g_malloc(weight_bytes);
+    activations = g_malloc(activation_bytes);
+
+    /* RTL fetch order is descriptor, activation stream, then weights. */
+    qbs_guest_read(env, activation_address, activations, activation_bytes,
+                   retaddr);
+    qbs_guest_read(env, descriptor.weight_base, weights, weight_bytes,
+                   retaddr);
+
+    elements = riscv_cpu_cfg(env)->vlenb / sizeof(uint32_t);
+    qbs_copy_destination_from_env(env, vd, registers, destination);
+    status = qbs_ref_execute(
+        &descriptor, m, vd, riscv_cpu_cfg(env)->vlenb * 8u,
+        activation_address, weights, weight_bytes, activations,
+        activation_bytes, destination, registers * elements, NULL, NULL,
+        &result);
+    if (status != QBS_REF_OK || result.destination_registers != registers ||
+        result.destination_elements_per_register != elements) {
+        qbs_raise_illegal(env, insn, retaddr);
+    }
+
+    qbs_commit_destination(env, vd, registers, destination);
+    riscv_cpu_set_fflags(env,
+        riscv_cpu_get_fflags(env) | (result.fflags & UINT32_C(0x1f)));
+    env->vstart = 0;
+}
