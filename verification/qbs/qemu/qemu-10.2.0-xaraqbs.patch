+# RISC-V translation routines for the Xaraqbs extension.
+
+%rs2 20:5
+%rs1 15:5
+%rd   7:5
+%m   25:2 !function=ex_plus_1
+
+&qbs_info rd rs1
+&qbs_exec rd rs1 rs2 m
+
+@qbs_info ....... ..... ..... ... ..... ....... &qbs_info %rs1 %rd
+@qbs_exec ....... ..... ..... ... ..... ....... &qbs_exec %m %rs2 %rs1 %rd
+
+qbinfo 0000000 00000 ..... 001 ..... 1011011 @qbs_info
+qbexec 00000.. ..... ..... 000 ..... 1011011 @qbs_exec
--- /dev/null
+++ b/target/riscv/insn_trans/trans_xaraqbs.c.inc
@@ -0,0 +1,48 @@
+/*
+ * RISC-V translation routines for the Xaraqbs extension.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+static bool trans_qbinfo(DisasContext *ctx, arg_qbinfo *a)
+{
+    TCGv index;
+    TCGv result;
+
+    if (ctx->mstatus_vs == EXT_STATUS_DISABLED ||
+        !ctx->cfg_ptr->ext_zve32f) {
+        return false;
+    }
+
+    index = get_gpr(ctx, a->rs1, EXT_NONE);
+    result = dest_gpr(ctx, a->rd);
+    gen_helper_qbs_info(result, tcg_env, index);
+    gen_set_gpr(ctx, a->rd, result);
+    return true;
+}
+
+static bool trans_qbexec(DisasContext *ctx, arg_qbexec *a)
+{
+    unsigned destination_registers;
+    TCGv descriptor;
+    TCGv activation;
+
+    destination_registers = a->m == 1 ? 1 : (a->m == 2 ? 2 : 4);
+    if (ctx->mstatus_vs == EXT_STATUS_DISABLED ||
+        ctx->mstatus_fs == EXT_STATUS_DISABLED ||
+        !ctx->cfg_ptr->ext_zve32f || !ctx->vstart_eq_zero ||
+        (a->rd % destination_registers) != 0 ||
+        a->rd + destination_registers > 32) {
+        return false;
+    }
+
+    descriptor = get_gpr(ctx, a->rs1, EXT_NONE);
+    activation = get_gpr(ctx, a->rs2, EXT_NONE);
+    gen_helper_qbs_exec(tcg_env, descriptor, activation,
+                        tcg_constant_i32(a->rd), tcg_constant_i32(a->m),
+                        tcg_constant_i32(ctx->opcode));
+    mark_vs_dirty(ctx);
+    mark_fs_dirty(ctx);
+    ctx->vstart_eq_zero = true;
+    return true;
+}
